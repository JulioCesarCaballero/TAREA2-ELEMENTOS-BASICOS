<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Texto que muestra la respuesta visible de cada demo -->
    <style name="TextoRespuesta">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Subtítulo pequeño dentro de una demo -->
    <style name="TextoEtiqueta">
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Columna con desplazamiento que usan todas las secciones -->
    <style name="ColumnaSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:divider">@drawable/espacio_16dp</item>
        <item name="android:showDividers">middle</item>
    </style>

    <!-- Nombre y explicación compactos (Sección 4) -->
    <style name="GuiaNombre">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="GuiaTexto">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Opción tocable de la hoja inferior (Sección 5) -->
    <style name="OpcionHoja">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">24dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <!-- Cuadro de color con una letra para visualizar distribuciones (Sección 6) -->
    <style name="Caja">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/fondo_caja</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Recuadro que simula una pantalla -->
    <style name="Marco">
        <item name="android:background">@drawable/fondo_marco</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>
