<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vacío: ilustración, mensaje y acción para recuperar los datos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/espacio_12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="40dp"
    android:paddingBottom="40dp"
    android:showDividers="middle">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/fondo_circulo"
        android:backgroundTint="?attr/colorSurfaceVariant">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_inbox"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="La lista está vacía"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No hay elementos para mostrar. Restaura la lista original o agrega uno nuevo desde la sección Entrada de texto."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <Button
        android:id="@+id/botonRestaurar"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restaurar lista"
        app:icon="@drawable/ic_refresh" />
</LinearLayout>
