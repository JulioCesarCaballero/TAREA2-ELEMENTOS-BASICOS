<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Barrita superior para arrastrar la hoja -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:text="¿Qué quieres hacer?"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <TextView
        android:id="@+id/opcionCompartir"
        style="@style/OpcionHoja"
        android:drawableStart="@drawable/ic_share"
        android:text="Compartir" />

    <TextView
        android:id="@+id/opcionEnlace"
        style="@style/OpcionHoja"
        android:drawableStart="@drawable/ic_link"
        android:text="Copiar enlace" />

    <TextView
        android:id="@+id/opcionDescargar"
        style="@style/OpcionHoja"
        android:drawableStart="@drawable/ic_download"
        android:text="Descargar" />
</LinearLayout>
